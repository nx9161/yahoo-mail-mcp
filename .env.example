# Copy to .env (project folder, current folder, or ~/.config/yahoo-mail/.env)
# and fill in your own values. NEVER commit a filled-in .env.

# Your full Yahoo Mail address
YAHOO_MAIL_ADDRESS=you@yahoo.com

# The 16-character APP PASSWORD from Yahoo Account Security
# (https://login.yahoo.com/account/security -> App passwords).
# Your main Yahoo password will NOT work — Yahoo rejects it for
# IMAP/SMTP by design.
YAHOO_MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
